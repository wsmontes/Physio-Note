{
  "name": "physio-note-server",
  "version": "1.0.0",
  "description": "Backend API for Physio-Note",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "touch /tmp/jest-localstorage && cross-env NODE_ENV=test NODE_OPTIONS='--localstorage-file=/tmp/jest-localstorage' jest --runInBand",
    "test:watch": "touch /tmp/jest-localstorage && cross-env NODE_ENV=test NODE_OPTIONS='--localstorage-file=/tmp/jest-localstorage' jest --watch --runInBand",
    "test:coverage": "touch /tmp/jest-localstorage && cross-env NODE_ENV=test NODE_OPTIONS='--localstorage-file=/tmp/jest-localstorage' jest --coverage --runInBand"
  },
  "keywords": [
    "physiotherapy",
    "api",
    "express"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.3.1",
    "form-data": "^4.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.28.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.2.0",
    "mongodb-memory-server": "^9.5.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.4"
  }
}
