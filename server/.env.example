# Server Configuration
NODE_ENV=development
PORT=5001

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/physio-note?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long

# OpenAI Configuration
OPENAI_API_KEY=sk-proj-your-api-key-here
OPENAI_MODEL=gpt-5-nano
OPENAI_WHISPER_MODEL=whisper-1

# WHO ICD-11 API (Free - Register at: https://icd.who.int/icdapi)
# Optional: If not provided, app uses local ICD-10 data
ICD_API_CLIENT_ID=your-client-id-here
ICD_API_CLIENT_SECRET=your-client-secret-here

# PubMed API (Free - No registration required)
# Optional: Email for API usage tracking (NCBI recommendation)
PUBMED_API_EMAIL=your-email@example.com

# CORS (Frontend URL)
CORS_ORIGIN=http://localhost:5173
